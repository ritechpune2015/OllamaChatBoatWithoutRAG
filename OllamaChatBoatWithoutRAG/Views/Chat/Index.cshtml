@model Conversation
<input type="hidden" id="conversationId" value="@Model.Id" />
<div class="container-fluid chat-container">
    <div class="row h-100">
        <div class="col-3 sidebar">
            <h4 class="mt-3">     Ollama Streaming Chat        </h4>
            <hr />
            <button class="btn btn-success w-100">
                + New Chat (Streaming)
            </button>
            <div id="conversationList" class="mt-3">
            </div>
        </div>
        <div class="col-9 chat-panel">
            <div id="messages" class="message-panel">
                <div class="alert alert-secondary">
                  (Streaming)  Welcome to Ollama AI Chat
                </div>
            </div>
            <div class="input-panel">
                <div class="input-group">
                    <input id="txtMessage" class="form-control" placeholder="Type your message..." />
                    <button type="button" id="btnSend" class="btn btn-primary">
                        Send
                    </button>

                    <button type="button" id="btnStop"
                            class="btn btn-danger"
                            disabled>
                        Stop
                    </button>

                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/chatstream.js"></script>